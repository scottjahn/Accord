{
  "name": "accord",
  "private": true,
  "version": "0.1.0",
  "description": "Accord of Stars - a turn-based space 4X",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "headless": "tsx src/runner/headless.ts",
    "batch": "tsx src/runner/batch.ts",
    "test:long": "node -e \"process.env.ACCORD_LONG='1';require('child_process').execSync('npx vitest run tests/ai/war.test.ts',{stdio:'inherit',env:process.env})\""
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "pixi.js": "^8.23.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
